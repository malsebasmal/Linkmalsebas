---
import { mainLinks, projectLinks, MAIN_HANDLE } from "@assets/socialLinks.ts"
---

<section aria-label="Social network links of malsebasmal" class="w-full max-w-md mx-auto px-4 py-8 font-mono flex flex-col gap-8">
  
  {/* SECCIÓN 1: Redes Principales (@malsebasmal) */}
  <div class="flex flex-col gap-3">
    <div class="pb-2 border-b border-white/20 flex items-center justify-between text-xs text-neutral-400">
      <span class="uppercase tracking-widest">// DIRECTORY</span>
      <span class="text-white font-semibold tracking-wider">{MAIN_HANDLE}</span>
    </div>

    <ul class="w-full flex flex-col gap-3">
      {mainLinks.map(({ icon: Icon, link, platform }) => (
        <li>
          <a 
            href={link} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full flex items-center justify-between p-3.5 border border-white/20 hover:border-white bg-black hover:bg-white text-white hover:text-black transition-all duration-150 group select-none"
          >
            <div class="flex items-center gap-3.5">
              <Icon class="size-5 transition-transform duration-150 group-hover:scale-110" />
              <span class="text-sm tracking-wide font-medium">{platform}</span>
            </div>

            <span class="text-xs tracking-widest text-neutral-400 group-hover:text-black opacity-0 group-hover:opacity-100 transition-all duration-150 transform -translate-x-2 group-hover:translate-x-0">
              [↗]
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  {/* SECCIÓN 2: Proyectos Paralelos & Otras Cuentas */}
  <div class="flex flex-col gap-3">
    <div class="pb-2 border-b border-white/20 flex items-center justify-between text-xs text-neutral-400">
      <span class="uppercase tracking-widest">// PROJECTS & ARCHIVES</span>
      <span class="text-neutral-500">[OTHER HANDLES]</span>
    </div>

    <ul class="w-full flex flex-col gap-3">
      {projectLinks.map(({ icon: Icon, link, platform, handle }) => (
        <li>
          <a 
            href={link} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full flex items-center justify-between p-3.5 border border-white/20 hover:border-white bg-black hover:bg-white text-white hover:text-black transition-all duration-150 group select-none"
          >
            <div class="flex items-center gap-3.5">
              <Icon class="size-5 transition-transform duration-150 group-hover:scale-110" />
              <span class="text-sm tracking-wide font-medium">{platform}</span>
            </div>

            <div class="flex items-center gap-3">
              <span class="text-xs text-neutral-400 group-hover:text-black/80 font-normal transition-colors">
                {handle}
              </span>

              <span class="text-xs tracking-widest text-neutral-400 group-hover:text-black opacity-0 group-hover:opacity-100 transition-all duration-150 transform -translate-x-2 group-hover:translate-x-0">
                [↗]
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>

</section>