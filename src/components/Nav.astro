---
import Share from "@images/icons/Share.astro"
import PopUp from "@components/PopUp.astro"
---

<nav class="w-full h-full py-4 px-0 md:px-6 flex items-center justify-between border-b border-white/10 font-mono">
  <span class="text-xs tracking-widest text-neutral-400 uppercase">
    // INDEX.LINKS
  </span>

  <button 
    id="popUpOpen" 
    class="flex items-center gap-2 px-3 py-1.5 border border-white/80 hover:bg-white hover:text-black transition-all duration-150 cursor-pointer text-xs tracking-wider uppercase group"
  >
    <Share class="size-3.5 transition-transform group-hover:scale-110" />
    <span>Share</span>
  </button>
</nav>

<PopUp id="popUp" />

<script>  
  document.querySelector("#popUpOpen")?.addEventListener("click", () => {
    document.querySelector("#popUp")?.classList.toggle("hidden")
  })
</script>