---
import Layout from "@layouts/Layout.astro"
import Nav from "@components/Nav.astro"
import Links from "@components/Links.astro"
import Footer from "@components/Footer.astro" // Nuevo componente
---

<Layout>
  <div class="w-full md:w-xl min-h-dvh md:border-x border-white/20 px-4 py-2 flex flex-col justify-between font-mono">
    
    <header class="w-full">
      <Nav />
    </header>

    <main class="w-full">
      <Links />
    </main>

		<Footer />
  </div>
</Layout>